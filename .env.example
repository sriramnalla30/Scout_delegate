# Copy this file to ".env" and fill in your keys.

# --- LLM: Groq (required) - https://console.groq.com ---
GROQ_API_KEY=gsk_your_key_here
# Optional second key; used by one step to spread the free-tier rate limit
GROQ_API_KEY_2=

# --- Place search: SerpStack (required) - https://serpstack.com ---
SERP_API_KEY=your_serpstack_key

# --- Review scraping: WebScraping.AI (optional) - https://webscraping.ai ---
WEBSCRAPING_AI_API_KEY=your_webscraping_ai_key

# --- Chat with the shop: WhatsApp via Twilio - https://console.twilio.com ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
# Free sandbox: Twilio console -> Messaging -> Try it out -> Send a WhatsApp message.
# Then send the "join <code>" message from your own WhatsApp to the sandbox number.
# TWILIO_WHATSAPP_NUMBER=+14155238886
# Used only when a shop has no phone number. Include the country code, e.g. +919876543210
DEFAULT_TARGET_NUMBER=
# Testing: message THIS number instead of the shop's (use your own WhatsApp, so no real shop gets a message)
# FORCE_TARGET_NUMBER=+919876543210

# --- Langfuse (required) - prompts + tracing - https://cloud.langfuse.com ---
# Project settings -> API keys. Every LLM prompt is loaded from Langfuse (see prompts/README.md).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Must match your project's region: EU = https://cloud.langfuse.com, US = https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
# false = don't send traces (keeps your laptop light; prompts still load from Langfuse)
# LANGFUSE_TRACING=false
# true = also save traces as files in a Google Drive folder (for testing from your laptop).
# First log in once: python scripts/google_drive_login.py   (see the README, "Save traces to Google Drive")
# DRIVE_TRACES=true
# DRIVE_FOLDER_NAME=place-discover-traces
# LANGFUSE_PROMPT_LABEL=production
# DEPLOYMENT_ENVIRONMENT=local

# --- Optional ---
# LLM_MODEL=openai/gpt-oss-120b
# LOG_LEVEL=INFO
