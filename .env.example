# Required
GROQ_API_KEY=your_groq_key

# Optional: Langfuse tracing and prompt versions. Both keys must be set to switch it on.
# The app reads only the keys it needs and does not export the rest of this file.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_TRACING=false        # switch tracing off without removing the keys
# LANGFUSE_TRACING_ENVIRONMENT=development   # the Environment these traces are filed under in Langfuse (the deployed container sets production)

# Optional overrides
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=low
# SCOUT_DATA_DIR=./data         # chat history and the agent's memory
# SCOUT_MAPS_PARALLEL=4         # area lookups running at the same time (each needs about 1 GB of memory)
# GMAPS_BIN=./bin/gmaps.exe     # the gosom google-maps-scraper binary used by the search tool
# GMAPS_TIMEOUT=90              # seconds one search may take
# GMAPS_PARALLEL=1              # searches running at the same time
# SEARCH_CACHE_MINUTES=30       # the same search again inside this time reuses the stored results (0 = off)

# Sign-in (see docs/DEPLOYMENT.md). Everyone signs in; each account sees only its own chats.
# GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com   # OAuth "Web application" client id; without it the Google button says it is not set up
# SESSION_DAYS=30                # how long a sign-in lasts
# SEED_USERS=me@example.com:my-password;you@example.com:your-password   # laptop only: accounts created at startup (the password follows this setting)
# LEGACY_CHATS_OWNER=me@example.com   # laptop only: chats saved before accounts existed are copied (once) into this account

# Hosting (see docs/DEPLOYMENT.md)
# HOST=127.0.0.1                 # 0.0.0.0 inside a container
# PORT=8000
# ALLOWED_ORIGINS=https://ramplacesearch.netlify.app   # pages on other sites that may call this API, comma separated
# CHAT_RATE_PER_HOUR=0           # messages one account may send per hour, 0 = no limit
