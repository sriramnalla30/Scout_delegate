# Required
GROQ_API_KEY=your_groq_key

# Optional: Langfuse tracing and prompt versions. Both keys must be set to switch it on.
# The app reads only the keys it needs and does not export the rest of this file.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_TRACING=false        # switch tracing off without removing the keys

# Optional overrides
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=low
# SCOUT_DATA_DIR=./data         # chat history and the agent's memory
# SCOUT_MAPS_PARALLEL=4         # area lookups running at the same time (each needs about 1 GB of memory)
# GMAPS_BIN=./bin/gmaps.exe     # the gosom google-maps-scraper binary used by the search tool
# GMAPS_TIMEOUT=90              # seconds one search may take
# GMAPS_PARALLEL=1              # searches running at the same time
# SEARCH_CACHE_MINUTES=30       # the same search again inside this time reuses the stored results (0 = off)
